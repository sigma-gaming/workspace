{
  "name": "@apps/games-api",
  "version": "0.0.10",
  "license": "UNLICENSED",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "yarn build:dev && concurrently 'yarn:dev:*' -c auto -k",
    "dev:build": "NODE_ENV=development webpack --watch",
    "dev:start": "NODE_ENV=development nodemon dist/main.js",
    "build": "NODE_ENV=production webpack",
    "build:dev": "NODE_ENV=development webpack",
    "start": "NODE_ENV=production nodemon dist/main.js",
    "start:dev": "NODE_ENV=development nodemon dist/main.js --inspect",
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,mts,jsx,tsx}\""
  },
  "dependencies": {
    "@libs/exceptions": "workspace:*",
    "@libs/games-db": "workspace:*",
    "@libs/games-model": "workspace:*",
    "@tooling/env": "workspace:*"
  }
}
