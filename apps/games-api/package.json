{
  "name": "@apis/games-api",
  "private": true,
  "main": "./src/client.ts",
  "module": "./src/client.ts",
  "types": "./src/client.ts",
  "type": "module",
  "scripts": {
    "copy-env": "copy-env",
    "dev": "bun run --hot src/main.ts",
    "build": "NODE_ENV=production bun run build.mjs",
    "build:dev": "NODE_ENV=development bun run build.mjs",
    "start": "NODE_ENV=production bun run dist/main.js",
    "preview": "dotenv -e .env.development -- bun run dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,jsx,tsx}\"",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "@core/flow": "workspace:*",
    "@core/di": "workspace:*",
    "@core/events": "workspace:*",
    "@core/exceptions": "workspace:*",
    "@core/io-client": "workspace:*",
    "@core/logger": "workspace:*",
    "@core/cron-jobs": "workspace:*",
    "@dbs/games-db": "workspace:*",
    "@dbs/games-schema": "workspace:*",
    "@games/model": "workspace:*",
    "@games/redis": "workspace:*",
    "@games/services": "workspace:*",
    "@tooling/env": "workspace:*"
  }
}