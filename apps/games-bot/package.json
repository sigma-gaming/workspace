{
  "name": "@bots/games-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-env": "copy-env",
    "dev": "NODE_ENV=development tsx watch src/main.ts --clear-screen=false",
    "build": "NODE_ENV=production bun build.mjs",
    "start": "NODE_ENV=production node dist/main.js",
    "preview": "NODE_ENV=development dotenv -e .env.development -- node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,jsx,tsx}\"",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "@dbs/games-db": "workspace:*",
    "@dbs/games-schema": "workspace:*",
    "@core/server": "workspace:*",
    "@games/services": "workspace:*",
    "@games/options": "workspace:*",
    "@core/di": "workspace:*",
    "@core/logger": "workspace:*",
    "@tooling/env": "workspace:*"
  }
}