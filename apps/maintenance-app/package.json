{
  "name": "@apps/maintenance-app",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "create-env": "node ./scripts/create-env.js",
    "dev": "dotenv -e .env.development pnpm create-env && vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server.js",
    "preview": "NODE_ENV=development dotenv -e .env.development node ./server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,jsx,tsx}\"",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "@core/ui": "workspace:*",
    "@tooling/env": "workspace:*"
  }
}
