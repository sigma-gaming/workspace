---
import SocialCallbackLayout from '../../../layouts/social-callback-layout.astro'

export const prerender = false

const payload = Astro.url.searchParams.get('payload')
const returnUrl = Astro.cookies.get('sigma_returnUrl')?.value
const accessUrl = Astro.cookies.get('sigma_accessUrl')?.value
---

<SocialCallbackLayout loaderColor="#0277FF">
  <vk-integration
    data-payload={payload}
    data-return-url={returnUrl}
    data-access-url={accessUrl}
  >
    <p class="mx-auto text-center">Выполняется&nbsp;вход через&nbsp;VK</p>
  </vk-integration>
</SocialCallbackLayout>

<script>
  import { AuthenticateResult } from '../../../api/types'
  import { authApi } from '../../../shared/api/auth'

  class VkIntegration extends HTMLElement {
    connectedCallback() {
      const payload = this.dataset.payload
      const returnUrl = this.dataset.returnUrl
      const accessUrl = this.dataset.accessUrl
      if (!payload || !returnUrl || !accessUrl) return

      authApi.authenticate
        .$post({
          json: { integration: 'vk', payload },
        })
        .then((res) => res.json())
        .then((authentication) => {
          if (authentication.result === AuthenticateResult.Connected) {
            window.location.replace(returnUrl)
            return
          }

          const params = new URLSearchParams()
          params.set('code', authentication.code)
          params.set('returnUrl', returnUrl)
          window.location.replace(`${accessUrl}/exchange?${params.toString()}`)
        })
    }
  }

  customElements.define('vk-integration', VkIntegration)
</script>
