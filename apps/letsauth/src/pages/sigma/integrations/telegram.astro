---
import SocialCallbackLayout from '../../../layouts/social-callback-layout.astro'
import { AuthenticationAction } from '../../../shared/api/auth'

export const prerender = false

const action = Astro.cookies.get('sigma_action')?.value
const returnUrl = Astro.cookies.get('sigma_returnUrl')?.value
const accessUrl = Astro.cookies.get('sigma_accessUrl')?.value
---

<SocialCallbackLayout loaderColor="#1893DF">
  <telegram-integration
    data-action={action}
    data-return-url={returnUrl}
    data-access-url={accessUrl}
  >
    <p class="mx-auto text-center">
      Выполняется&nbsp;{
        action === AuthenticationAction.SignIn ? 'вход через' : 'привязка'
      }&nbsp;Telegram
    </p>
  </telegram-integration>
</SocialCallbackLayout>

<script>
  import {
    AuthenticateOutcome,
    AuthenticationAction,
    AuthenticationIntegration,
    postAuthenticate,
  } from '../../../shared/api/auth'

  class TelegramIntegration extends HTMLElement {
    async connectedCallback() {
      const payload = window.location.hash.split('tgAuthResult=')[1]
      const integration = AuthenticationIntegration.Telegram
      const action = this.dataset.action as AuthenticationAction
      const returnUrl = this.dataset.returnUrl
      const accessUrl = this.dataset.accessUrl

      if (!action || !payload || !returnUrl || !accessUrl) return

      const authentication = await postAuthenticate({
        app: 'sigma',
        action,
        integration,
        payload,
      })

      if (authentication.outcome === AuthenticateOutcome.Connected) {
        window.location.replace(returnUrl)
        return
      }

      if (authentication.outcome === AuthenticateOutcome.NotAuthenticated) {
        const url = `/sigma/errors/not-authenticated?returnUrl=${returnUrl}`
        window.location.replace(url)
        return
      }

      if (!authentication.code) {
        const url = `/sigma/errors/unknown?returnUrl=${returnUrl}`
        window.location.replace(url)
        return
      }

      const params = new URLSearchParams()
      params.set('code', authentication.code)
      params.set('returnUrl', returnUrl)
      window.location.replace(`${accessUrl}/exchange?${params.toString()}`)
    }
  }

  customElements.define('telegram-integration', TelegramIntegration)
</script>
