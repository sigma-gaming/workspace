---
import { Image } from 'astro:assets'
import logoImg from '../shared/assets/logo.webp'

interface Props {
  pageTitle?: string
}

const { pageTitle } = Astro.props

const title = ['LetsAuth', pageTitle].filter(Boolean).join(' - ')
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta
      name="description"
      content="Сервис авторизации через социальные сети для вашего бизнеса"
    />
    <meta name="theme-color" content="#200b47" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0"
    />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="LetsAuth" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@300..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#200b47] text-gray-100 font-interface flex flex-col py-2">
    <header class="mx-auto p-6 text-center">
      <a href="/">
        <Image
          class="w-[200px] md:w-[280px] mx-auto"
          src={logoImg}
          alt="LetsAuth"
          widths={[400, 560]}
          width={560}
          sizes="(max-width: 767px) 400px, 560px"
          quality={100}
          loading="eager"
        />
      </a>
    </header>

    <main
      class="flex-grow mx-auto p-6 flex flex-col items-center justify-center"
    >
      <slot />
    </main>

    <footer class="mx-auto px-6 py-4 text-center">
      <p class="inline-flex flex-col gap-x-1 md:flex-row opacity-50">
        <span>&copy; 2023 LetsAuth.</span>
        <span>Все&nbsp;права&nbsp;защищены.</span>
      </p>
    </footer>
  </body>
</html>
