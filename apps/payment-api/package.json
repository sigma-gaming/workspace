{
  "name": "@apis/payment-api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "copy-env": "copy-env",
    "dev": "NODE_ENV=development bun run --hot src/main.ts",
    "build": "NODE_ENV=production bun run build.mjs",
    "start": "NODE_ENV=production bun run dist/main.js",
    "preview": "dotenv -e .env.development -- bun run dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,jsx,tsx}\"",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "@dbs/games-db": "workspace:*",
    "@dbs/games-schema": "workspace:*",
    "@games/redis": "workspace:*",
    "@games/services": "workspace:*",
    "@games/options": "workspace:*",
    "@core/di": "workspace:*",
    "@core/logger": "workspace:*",
    "@tooling/env": "workspace:*"
  }
}