{
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@tooling/build": [
        "tooling/build/src/index.ts"
      ],
      "@tooling/env": [
        "tooling/env/src/index.ts"
      ],
      "@tooling/env/client": [
        "tooling/env/src/client.ts"
      ],
      "@tooling/env-vite-plugin": [
        "tooling/env-vite-plugin/src/index.ts"
      ],
      "@apis/control-api": [
        "apps/control-api/src/client.ts"
      ],
      "@apis/letsauth": [
        "apps/letsauth/src/client.ts"
      ],
      "@core/exceptions": [
        "core/exceptions/src/index.ts"
      ],
      "@games/model": [
        "games-libs/model/src/index.ts"
      ],
      "@core/forms": [
        "core/forms/src/index.ts"
      ],
      "@core/ui": [
        "core/ui/src/index.ts"
      ],
      "@core/ui/tailwind": [
        "core/ui/src/tailwind.ts"
      ],
      "@core/client": [
        "core/client/src/index.ts"
      ],
      "@core/utils": [
        "core/utils/src/index.ts"
      ]
    }
  }
}