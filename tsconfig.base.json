{
  "exclude": ["node_modules", "**/dist"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@sigma/games-db": ["libs/games-db/generated"],
      "@sigma/games-model": ["libs/games-model/src/index.ts"],
      "@sigma/exceptions": ["libs/exceptions/src/index.ts"]
    }
  }
}
