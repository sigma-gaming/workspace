{
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@tooling/build": [
        "tooling/build/src/index.ts"
      ],
      "@tooling/env": [
        "tooling/env/src/index.ts"
      ],
      "@apis/games-api": [
        "apps/games-api/src/client.ts"
      ],
      "@apis/control-api": [
        "apps/control-api/src/client.ts"
      ],
      "@core/exceptions": [
        "core/exceptions/src/index.ts"
      ],
      "@dbs/games-db": [
        "dbs/games-db/src/index.ts"
      ],
      "@dbs/games-schema": [
        "dbs/games-schema/src/index.ts"
      ],
      "@games/model": [
        "games-libs/model/src/index.ts"
      ],
      "@games/services": [
        "games-libs/services/src/index.ts"
      ],
      "@games/redis": [
        "games-libs/redis/src/index.ts"
      ],
      "@games/queue": [
        "games-libs/queue/src/index.ts"
      ],
      "@core/logger": [
        "core/logger/src/index.ts"
      ],
      "@core/cron-jobs": [
        "core/cron-jobs/src/index.ts"
      ],
      "@core/forms": [
        "core/forms/src/index.ts"
      ],
      "@core/ui": [
        "core/ui/src/index.ts"
      ],
      "@core/ui/tailwind": [
        "core/ui/src/tailwind.ts"
      ],
      "@core/di": [
        "core/di/src/index.ts"
      ],
      "@core/events": [
        "core/events/src/index.ts"
      ],
      "@core/hono-client": [
        "core/hono-client/src/index.ts"
      ],
      "@core/hono-ws": [
        "core/hono-ws/src/index.ts"
      ]
    }
  }
}