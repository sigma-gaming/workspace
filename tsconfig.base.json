{
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@tooling/build": [
        "tooling/build/src/index.ts"
      ],
      "@tooling/env": [
        "tooling/env/src/index.ts"
      ],
      "@apps/games-api": [
        "apps/games-api/src/client.ts"
      ],
      "@apps/control-api": [
        "apps/control-api/src/client.ts"
      ],
      "@libs/exceptions": [
        "libs/exceptions/src/index.ts"
      ],
      "@libs/games-db": [
        "libs/games-db/src/index.ts"
      ],
      "@libs/games-db-schema": [
        "libs/games-db-schema/src/index.ts"
      ],
      "@libs/games-model": [
        "libs/games-model/src/index.ts"
      ],
      "@libs/games-redis": [
        "libs/games-redis/src/index.ts"
      ],
      "@libs/games-queue": [
        "libs/games-queue/src/index.ts"
      ],
      "@libs/logger": [
        "libs/logger/src/index.ts"
      ],
      "@libs/forms": [
        "libs/forms/src/index.ts"
      ],
      "@libs/ui": [
        "libs/ui/src/index.ts"
      ]
    }
  }
}