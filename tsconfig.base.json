{
  "exclude": ["node_modules", "**/dist"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@apps/games-api": ["apps/games-api/src/client.ts"],
      "@libs/exceptions": ["libs/exceptions/src/index.ts"],
      "@libs/games-db": ["libs/games-db/dist"],
      "@libs/games-model": ["libs/games-model/src/index.ts"],
      "@libs/ssr-bindings": ["libs/ssr-bindings/src/index.ts"],
      "@tooling/build": ["libs/build/src/index.ts"],
      "@tooling/env": ["libs/env/src/index.ts"]
    }
  }
}
