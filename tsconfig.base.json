{
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@tooling/build": [
        "tooling/build/src/index.ts"
      ],
      "@tooling/env": [
        "tooling/env/src/index.ts"
      ],
      "@apis/games-api": [
        "apps/games-api/src/client.ts"
      ],
      "@apis/control-api": [
        "apps/control-api/src/client.ts"
      ],
      "@libs/exceptions": [
        "libs/exceptions/src/index.ts"
      ],
      "@dbs/games-db": [
        "dbs/games-db/src/index.ts"
      ],
      "@dbs/games-schema": [
        "dbs/games-schema/src/index.ts"
      ],
      "@games/model": [
        "games-libs/model/src/index.ts"
      ],
      "@games/services": [
        "games-libs/services/src/index.ts"
      ],
      "@games/redis": [
        "games-libs/redis/src/index.ts"
      ],
      "@games/queue": [
        "games-libs/queue/src/index.ts"
      ],
      "@libs/logger": [
        "libs/logger/src/index.ts"
      ],
      "@libs/cron-jobs": [
        "libs/cron-jobs/src/index.ts"
      ],
      "@libs/forms": [
        "libs/forms/src/index.ts"
      ],
      "@libs/ui": [
        "libs/ui/src/index.ts"
      ],
      "@libs/ui/tailwind": [
        "libs/ui/src/tailwind.ts"
      ],
      "@libs/di": [
        "libs/di/src/index.ts"
      ],
      "@libs/events": [
        "libs/events/src/index.ts"
      ],
      "@libs/hono-client": [
        "libs/hono-client/src/index.ts"
      ],
      "@libs/hono-ws": [
        "libs/hono-ws/src/index.ts"
      ]
    }
  }
}