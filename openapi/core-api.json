  "components": {
    "schemas": {
      "Account": {
        "required": [
          "createdAt",
          "id",
          "provider",
          "providerUserFirstName",
          "providerUserId",
          "updatedAt",
          "userId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "providerUserId": {
            "type": "string"
          },
          "providerUsername": {
            "type": "string",
            "nullable": true
          },
          "providerUserFirstName": {
            "type": "string"
          },
          "providerUserLastName": {
            "type": "string",
            "nullable": true
          },
          "providerUserImage": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "$ref": "#/components/schemas/AccountProvider"
          }
        },
        "additionalProperties": false
      },
      "AccountProvider": {
        "enum": [
          "Vk",
          "Telegram"
        ],
        "type": "string"
      },
      "ApplyPromocodePayload": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ApplyPromocodeResponse": {
        "required": [
          "balance",
          "bonusType",
          "payout"
        ],
        "type": "object",
        "properties": {
          "bonusType": {
            "$ref": "#/components/schemas/PromocodeBonusType"
          },
          "payout": {
            "type": "integer",
            "format": "int64"
          },
          "balance": {
            "$ref": "#/components/schemas/BalancePublicUserUpdate"
          }
        },
        "additionalProperties": false
      },
      "BalancePublic": {
        "required": [
          "available",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "available": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "BalancePublicUserUpdate": {
        "required": [
          "data",
          "mode",
          "time",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "time": {
            "type": "integer",
            "format": "int64"
          },
          "mode": {
            "$ref": "#/components/schemas/UpdateMode"
          },
          "data": {
            "$ref": "#/components/schemas/BalancePublic"
          }
        },
        "additionalProperties": false
      },
      "BasePlayPayload": {
        "required": [
          "bet"
        ],
        "type": "object",
        "properties": {
          "bet": {
            "maximum": 500000,
            "minimum": 100,
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "ChatMessage": {
        "required": [
          "createdAt",
          "id",
          "isPinned",
          "senderRoles",
          "trackingId",
          "type"
        ],
        "type": "object",
        "properties": {
          "trackingId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string",
            "nullable": true
          },
          "attachments": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ChatMessageAttachmentGame"
                }
              ]
            }
          },
          "senderName": {
            "type": "string",
            "nullable": true
          },
          "senderUsername": {
            "type": "string",
            "nullable": true
          },
          "senderImage": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "isPinned": {
            "type": "boolean"
          },
          "profileId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/ChatMessageType"
          },
          "senderRoles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRole"
            }
          }
        },
        "additionalProperties": false
      },
      "ChatMessageAttachment": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatMessageAttachmentGame"
          }
        ],
        "additionalProperties": false,
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "Game": "#/components/schemas/ChatMessageAttachmentGame"
          }
        }
      },
      "ChatMessageAttachmentGame": {
        "required": [
          "gameRecordId",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "Game"
            ],
            "type": "string",
            "readOnly": true
          },
          "gameRecordId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ChatMessageAttachmentType": {
        "enum": [
          "Game"
        ],
        "type": "string"
      },
      "ChatMessagePayload": {
        "required": [
          "trackingId"
        ],
        "type": "object",
        "properties": {
          "text": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string",
            "nullable": true
          },
          "attachments": {
            "maxItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ChatMessageAttachmentGame"
                }
              ]
            },
            "nullable": true
          },
          "trackingId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ChatMessageType": {
        "enum": [
          "UserMessage",
          "SystemMessage"
        ],
        "type": "string"
      },
      "ClaimRewardResponse": {
        "required": [
          "balance",
          "payout",
          "task"
        ],
        "type": "object",
        "properties": {
          "payout": {
            "type": "integer",
            "format": "int64"
          },
          "task": {
            "$ref": "#/components/schemas/GlobalTaskStatusUserUpdate"
          },
          "balance": {
            "$ref": "#/components/schemas/BalancePublicUserUpdate"
          }
        },
        "additionalProperties": false
      },
      "CompleteTaskPayload": {
        "required": [
          "taskKey"
        ],
        "type": "object",
        "properties": {
          "taskKey": {
            "$ref": "#/components/schemas/GlobalTaskKey"
          }
        },
        "additionalProperties": false
      },
      "CompleteTaskResponse": {
        "required": [
          "task"
        ],
        "type": "object",
        "properties": {
          "task": {
            "$ref": "#/components/schemas/GlobalTaskStatusUserUpdate"
          }
        },
        "additionalProperties": false
      },
      "ConnectResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Currency": {
        "enum": [
          "Rub",
          "Kzt",
          "Kgs",
          "Uzs",
          "Uah",
          "Usd",
          "Eur",
          "Trx",
          "UsdtTrc20",
          "UsdtErc20",
          "Btc",
          "Ltc",
          "Ton",
          "Not",
          "Eth",
          "Bnb",
          "Doge"
        ],
        "type": "string"
      },
      "CurrencyExchangeRates": {
        "required": [
          "map"
        ],
        "type": "object",
        "properties": {
          "map": {
            "type": "object",
            "properties": {
              "Rub": {
                "type": "number",
                "format": "double"
              },
              "Kzt": {
                "type": "number",
                "format": "double"
              },
              "Kgs": {
                "type": "number",
                "format": "double"
              },
              "Uzs": {
                "type": "number",
                "format": "double"
              },
              "Uah": {
                "type": "number",
                "format": "double"
              },
              "Usd": {
                "type": "number",
                "format": "double"
              },
              "Eur": {
                "type": "number",
                "format": "double"
              },
              "Trx": {
                "type": "number",
