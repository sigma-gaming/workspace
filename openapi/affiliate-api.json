{
  "openapi": "3.0.1",
  "info": {
    "title": "API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://affiliate.sigma.local:5160"
    },
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/campaigns/by-code/{code}": {
      "get": {
        "tags": [
          "Affiliate"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferralCampaign"
                }
              }
            }
          }
        }
      }
    },
    "/campaigns/{id}/increment-visits": {
      "post": {
        "tags": [
          "Affiliate"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReferralCampaign": {
        "required": [
          "code",
          "createdAt",
          "id",
          "name",
          "totalSignups",
          "totalVisits"
        ],
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "totalVisits": {
            "type": "integer",
            "format": "int32"
          },
          "totalSignups": {
            "type": "integer",
            "format": "int32"
          },
          "referrerId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      }
    }
  }
}