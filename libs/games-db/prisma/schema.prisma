generator client {
  provider      = "prisma-client-js"
  output        = "../dist"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  User
  Moderator
  Admin
}

enum AccountProvider {
  VK
  Telegram
}

enum TransactionType {
  Deposit
  Withdrawal
  Bet
  Win
  Loss
}

enum Game {
  Dice
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamp(6)

  roles UserRole[] @default([User])

  profile      Profile?
  accounts     Account[]
  sessions     Session[]
  transactions Transaction[]
}

model Profile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @default(now()) @db.Timestamp(6)

  name         String?         @db.Text
  username     String?         @unique @db.Text
  usedProvider AccountProvider

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime        @default(now()) @db.Timestamp(6)
  updatedAt             DateTime        @updatedAt @default(now()) @db.Timestamp(6)
  provider              AccountProvider
  providerUserId        String          @db.Text
  providerUsername      String?         @db.Text
  providerUserFirstName String?         @db.Text
  providerUserLastName  String?         @db.Text
  providerUserImage     String?         @db.Text

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamp(6)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)

  type TransactionType
  game Game?

  openingBalance Float @default(0)
  closingBalance Float
  amount         Float

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction)
}

model Budget {
  id         Int      @id
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @default(now()) @db.Timestamp(6)
  lastSyncAt DateTime @default(now()) @db.Timestamp(6)

  available    Float
  unwantedLoss Float
  maxLoss      Float
}

model GlobalSettings {
  id         Int      @id
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @default(now()) @db.Timestamp(6)

  maintenanceMode Boolean @default(false)
}
