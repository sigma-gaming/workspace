{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "shared": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/nx.json"
    ],
    "env": ["{workspaceRoot}/.env.development"],
    "src": [
      "{projectRoot}/index.html",
      "{projectRoot}/server-dev.js",
      "{projectRoot}/server-prod.js",
      "{projectRoot}/prisma/schema.prisma",
      "{projectRoot}/public/**/*",
      "{projectRoot}/src/**/*",
      "!{projectRoot}/src/*.test.ts",
      "!{projectRoot}/src/*.test.tsx",
      "{projectRoot}/build.*",
      "{projectRoot}/scripts/**/*"
    ],
    "dist": ["{projectRoot}/dist/**/*"],
    "test": [
      "{projectRoot}/**/*.test.ts",
      "{projectRoot}/**/*.test.tsx",
      "{projectRoot}/jest.config.ts",
      "{projectRoot}/jest.config.js"
    ],
    "config": [
      "{projectRoot}/package.json",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/tsconfig.app.json",
      "{projectRoot}/tsconfig.spec.json",
      "{projectRoot}/vite.config.*",
      "{projectRoot}/next.config.*",
      "{projectRoot}/rollup.config.*",
      "{projectRoot}/webpack.config.*"
    ],
    "migrations": ["{projectRoot}/prisma/migrations/**/*"]
  },
  "targetDefaults": {
    "copy-env": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["env"],
      "outputs": ["{projectRoot}/.env.development"],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 123"
      }
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist", "{workspaceRoot}/dist/{projectRoot}"],
      "inputs": ["shared", "config", "src", "^src"]
    },
    "test": {
      "cache": true,
      "inputs": [
        "shared",
        "config",
        "test",
        "src",
        "^src",
        "{workspaceRoot}/jest.preset.js"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["shared", "config", "test", "src", "^src"]
    },
    "lint": {
      "cache": true,
      "inputs": ["shared", "config", "test", "src"]
    },
    "dev": {
      "dependsOn": ["^build", "copy-env"]
    },
    "preview": {
      "dependsOn": ["copy-env", "build"]
    },
    "migrate": {
      "inputs": ["shared", "config", "migrations"]
    },
    "start": {
      "dependsOn": ["build", "^build", "^migrate"]
    }
  },
  "affected": {
    "defaultBase": "main"
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false
    }
  },
  "nxCloudAccessToken": "NX_CLOUD_TOKEN_REMOVED"
}
