    "@types/node": "^20.9.0",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "@types/scroll-lock": "^2.1.3",
    "@types/uuid": "^9.0.7",
    "@types/webpack": "^5.28.5",
    "@types/webpack-node-externals": "^3.0.4",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.3.0",
    "drizzle-kit": "^0.23.1",
    "esbuild": "^0.20.2",
    "eslint": "^8.56.0",
    "eslint-kit": "^11.0.1",
    "is-ci": "^3.0.1",
    "node-loader": "^2.0.0",
    "nodemon": "^3.0.1",
    "nx": "17.0.2",
    "postcss": "^8.4.32",
    "postcss-preset-mantine": "^1.12.2",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.3",
