{
  "name": "@sigma/workspace",
  "version": "0.0.0-workspace",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/sigma-gaming/workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigma-gaming/workspace"
  },
  "workspaces": [
    "apps/*",
    "dbs/*",
    "core/*",
    "tooling/*",
    "games-libs/*"
  ],
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev:compose": "docker compose -f local.docker-compose.yml",
    "dev:docker": "pnpm dev:compose up -d",
    "dev:docker:reset": "pnpm dev:compose down -v && pnpm dev:docker",
    "dev:games-app": "nx run @apps/games-app:dev",
    "dev:games-api": "nx run @apis/games-api:dev",
    "dev:games-ws": "nx run @apis/games-ws:dev",
    "dev:games:migrate": "nx run @dbs/games-db:migration:dev",
    "dev:control-app": "nx run @apps/control-app:dev",
    "dev:control-api": "nx run @apis/control-api:dev",
    "dev": "nx run-many -t dev --parallel 10",
    "dev:games": "nx run-many -t dev --projects @apps/games-app,@apis/games-api,@apis/games-ws",
    "check": "CI=true pnpm nx run-many -t build test lint typecheck --parallel 3",
    "check:affected": "CI=true pnpm nx affected -t build test lint typecheck --parallel 3",
    "typecheck": "pnpm nx run-many -t typecheck",
    "test": "pnpm nx run-many -t test --watch",
    "lint": "pnpm nx run-many -t lint",
    "lint:fix": "pnpm nx run-many -t lint:fix",
    "changeset:publish": "changeset tag && git push --follow-tags",
    "cert:generate": "mkcert -key-file ssl/local.key -cert-file ssl/local.crt localhost sigma.local '*.sigma.local'",
    "cert:install": "mkcert -install"
  },
  "dependencies": {
    "@farfetched/core": "^0.11.2",
    "@fastify/basic-auth": "^5.1.1",
    "@fastify/cors": "^8.4.2",
    "@fastify/static": "^6.12.0",
    "@fastify/websocket": "^8.2.0",
    "@hono/node-server": "^1.11.4",
    "@hono/node-ws": "^1.0.1",
    "@hono/zod-validator": "^0.2.2",
    "@mantine/core": "^7.12.1",
    "@mantine/dates": "^7.12.1",
    "@mantine/hooks": "^7.12.1",
    "@mantine/notifications": "^7.12.1",
    "@neodx/colors": "^0.2.8",
    "@neodx/log": "^0.3.0",
    "@risenx/howler": "^2.3.2",
    "@rive-app/react-canvas": "^4.8.3",
    "@sentry/node": "^8.13.0",
    "@sentry/profiling-node": "^8.13.0",
    "@sentry/react": "^8.13.0",
    "@sesamecare-oss/redlock": "^1.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tabler/icons-react": "^2.44.0",
    "@withease/factories": "^1.0.3",
    "atomic-router": "^0.9.3",
    "atomic-router-react": "^0.9.1",
    "axios": "^1.6.2",
    "clsx": "^2.1.0",
    "cookie": "^0.6.0",
    "core-js": "^3.37.1",
    "cron": "^3.1.6",
    "dayjs": "^1.11.10",
    "drizzle-orm": "^0.32.1",
    "effector": "^23.0.0",
    "effector-react": "^23.0.1",
    "effector-storage": "^7.1.0",
    "fastify": "^4.24.3",
    "framer-motion": "^10.18.0",
    "grammy": "^1.20.1",
    "history": "^5.3.0",
    "hono": "^4.4.7",
    "ioredis": "^5.3.2",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "patronum": "^2.2.0",
    "postgres": "^3.4.3",
    "rabbitmq-client": "^4.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-geiger": "^1.0.2",
    "reflect-metadata": "^0.2.1",
    "scroll-lock": "^2.1.5",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "superjson": "^2.2.1",
    "ts-morph": "^20.0.0",
    "tsyringe-neo": "^5.0.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.43.0",
    "uuid": "^9.0.1",
    "ws": "^8.17.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
