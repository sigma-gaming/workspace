    "@fastify/websocket": "^8.2.0",
    "@mantine/core": "^7.3.2",
    "@mantine/hooks": "^7.3.2",
    "@mantine/notifications": "^7.3.2",
    "@neodx/log": "^0.3.0",
    "@prisma/client": "^5.8.1",
    "@sesamecare-oss/redlock": "^1.2.0",
    "@tabler/icons-react": "^2.44.0",
    "@trpc/client": "^10.44.1",
    "@trpc/server": "^10.44.1",
    "atomic-router": "^0.9.3",
    "atomic-router-react": "^0.9.1",
    "axios": "^1.6.2",
    "clsx": "^2.1.0",
    "cookie": "^0.6.0",
    "cron": "^3.1.6",
    "effector": "^23.0.0",
    "effector-react": "^23.0.1",
    "express": "^4.18.2",
    "fastify": "^4.24.3",
    "framer-motion": "^10.18.0",
    "grammy": "^1.20.1",
    "history": "^5.3.0",
    "ioredis": "^5.3.2",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "patronum": "^2.1.1",
    "pino": "^8.16.2",
    "rabbitmq-client": "^4.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "superjson": "^2.2.1",
