{
  "name": "@uniroute/root",
  "version": "0.0.0-internal",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/sigma-gaming/uniroute",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigma-gaming/uniroute"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "postinstall": "is-ci || husky install",
    "games-web:dev": "nx run @sigma/games-web:dev",
    "games-web:build": "nx run @sigma/games-web:build",
    "games-web:start": "nx run @sigma/games-web:start",
    "games-api:dev": "nx run @sigma/games-api:dev",
    "games-api:build": "nx run @sigma/games-api:build",
    "games-api:start": "nx run @sigma/games-api:start",
    "changeset:publish": "nx affected:build && changeset tag && git push --follow-tags",
    "dockerize:prepare": "mkdir -p node_modules_unlinked && cp -L -r node_modules/* node_modules_unlinked/",
    "games-api:dockerize": "yarn games-api:build && yarn dockerize:prepare && docker build -f apps/games-api/Dockerfile ."
  },
  "dependencies": {
    "@fastify/static": "^6.12.0",
    "@fastify/websocket": "^8.2.0",
    "@prisma/client": "^5.6.0",
    "@trpc/client": "^10.44.1",
    "@trpc/server": "^10.44.1",
    "cookie": "^0.6.0",
    "fastify": "^4.24.3",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.16.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-morph": "^20.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@fastify/vite": "^5.0.4",
    "@nx/js": "17.0.2",
    "@nx/workspace": "17.0.2",
    "@types/cookie": "^0.5.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@types/webpack": "^5.28.5",
    "@types/webpack-node-externals": "^3.0.4",
    "@vitejs/plugin-react": "^4.2.0",
    "@yarnpkg/types": "^4.0.0",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.3.0",
    "esbuild": "^0.19.6",
    "eslint": "^8.53.0",
    "eslint-kit": "^10.0.0",
    "husky": "^8.0.3",
    "is-ci": "^3.0.1",
    "nodemon": "^3.0.1",
    "nx": "17.0.2",
    "pino-pretty": "^10.2.3",
    "pino-webpack-plugin": "^2.0.0",
    "prettier": "^3.1.0",
    "prisma": "^5.6.0",
    "ts-loader": "^9.5.1",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.1.3",
    "vite": "^5.0.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "packageManager": "yarn@4.0.1",
  "volta": {
    "node": "20.10.0"
  }
}
