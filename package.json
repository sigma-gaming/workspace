{
  "name": "@sigma/workspace",
  "version": "0.0.0-workspace",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/sigma-gaming/workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigma-gaming/workspace"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "tooling/*"
  ],
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "nx run-many -t dev -p @apps/games-app @apps/games-api --parallel",
    "dev:services": "docker compose -f local.docker-compose.yml  up -d",
    "check": "yarn constraints && yarn nx affected --target build test lint typecheck --parallel 3",
    "changeset:publish": "changeset tag && git push --follow-tags",
    "cert:generate": "mkcert -key-file ssl/local.key -cert-file ssl/local.crt localhost sigma.local '*.sigma.local'",
    "cert:install": "mkcert -install"
  },
  "dependencies": {
    "@farfetched/core": "^0.11.2",
    "@fastify/basic-auth": "^5.1.1",
    "@fastify/cors": "^8.4.2",
