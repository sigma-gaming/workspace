{
  "name": "@sigma/workspace",
  "version": "0.0.0-workspace",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/sigma-gaming/workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigma-gaming/workspace"
  },
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev:compose": "docker compose -f ./local-compose/docker-compose.yml",
    "dev:docker": "pnpm dev:compose up -d --remove-orphans",
    "dev:docker:reset": "pnpm dev:compose down -v && pnpm dev:docker",
    "dev:docker:preview": "docker compose -f ./local-compose/preview.docker-compose.yml up",
    "dev:games-app": "nx run @apps/games-app:dev",
    "dev:games-api": "nx run @apis/games-api:dev",
    "dev:games-ws": "nx run @apis/games-ws:dev",
    "dev:redirect": "nx run @apis/redirect-api:dev",
    "dev:payment": "nx run @apis/payment-api:dev",
    "dev:payment:bovapay": "cloudflared tunnel run bovapay",
    "dev": "nx run-many -t dev --parallel 10",
    "dev:games": "nx run-many -t dev --projects @apps/games-app,@apis/games-api,@apis/games-ws,@apis/games-tasks --parallel 10",
    "dev:games:bot": "nx run @bots/games-bot:dev",
    "dev:auth": "nx run-many -t dev --projects @apis/access-api,@apis/letsauth --parallel 10",
    "dev:control": "nx run-many -t dev --projects @apis/control-api,@apps/control-app --parallel 10",
    "dev:domain": "nx run @apis/domain-api:dev",
    "check": "CI=true pnpm nx run-many -t build test lint typecheck --parallel 5",
    "check:affected": "CI=true pnpm nx affected -t build test lint typecheck --parallel 5",
    "typecheck": "pnpm nx run-many -t typecheck",
    "build": "pnpm nx run-many -t build",
    "test": "pnpm nx run-many -t test --watch",
    "lint": "pnpm nx run-many -t lint",
    "lint:fix": "pnpm nx run-many -t lint:fix",
    "changeset:publish": "changeset tag && git push --follow-tags",
    "cert:generate": "mkcert -key-file ssl/local.key -cert-file ssl/local.crt localhost sigma.local '*.sigma.local' auth.local",
    "cert:install": "mkcert -install"
  },
  "dependencies": {
    "@astrojs/node": "^8.3.4",
    "@effector/reflect": "^9.2.0",
    "@farfetched/core": "^0.11.4",
    "@grammyjs/auto-retry": "^2.0.2",
