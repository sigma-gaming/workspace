{
  "name": "@games/db",
  "version": "0.0.0-internal",
  "license": "MIT",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "copy-env": "copy-env",
    "migration:generate": "dotenv -e .env.development -- drizzle-kit generate:pg",
    "migration:apply": "node migrate.mjs",
    "migration:apply:dev": "dotenv -e .env.development -- yarn migration:apply",
    "migration:dev": "yarn migration:generate && yarn migration:apply:dev",
    "reset": "dotenv -e .env.development -- node reset.mjs",
    "studio": "dotenv -e .env.development -- drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,mts,jsx,tsx}\"",
    "lint:fix": "yarn lint --fix"
  },
  "dependencies": {
    "@games/db-schema": "workspace:*",
    "@libs/di": "workspace:*",
    "@tooling/env": "workspace:*"
  }
}
